{
  "expo": {
    "name": "Parla",
    "slug": "sprachapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0F",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Parla braucht dein Mikrofon, um deine Sprache aufzunehmen und zu transkribieren.",
        "NSUbiquitousContainers": {
          "iCloud.com.afitterling.sprachapp": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Parla",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        }
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.afitterling.sprachapp"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.afitterling.sprachapp"
        ]
      },
      "bundleIdentifier": "com.afitterling.sprachapp",
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Parla braucht dein Mikrofon, um deine Sprache aufzunehmen und zu transkribieren."
        }
      ],
      "expo-localization",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "7a1ef937-99a2-49f0-b348-1f095849b078"
      }
    },
    "owner": "afitterling"
  }
}
