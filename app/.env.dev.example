# Parla — local dev API keys template. Copy to `.env.dev` and fill in real keys.
# Expo only inlines vars prefixed with EXPO_PUBLIC_ into the app bundle.

# OpenAI — powers Whisper voice transcription. https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# Claude (Anthropic) — powers the dialogue. https://console.anthropic.com/
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...
